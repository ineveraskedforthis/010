
########################
###    FLAG  VARS    ###
########################

cpp_cmpl      = clang++-20
c_cmpl        = clang-20
cpp_std       = -DPREFER_ONE_TBB -std=c++20

optm_flag     = -O0

dbg_flag      = -g
link_flag     = -g

luna_flag     = $optm_flag $dbg_flag -mavx2
imgui_flag    = $optm_flag $dbg_flag -mavx2
game_flag     = $optm_flag $dbg_flag -DWINDOW_SERVER_X11 -mavx2
hb_flag       = $optm_flag $dbg_flag -D_CRT_SECURE_NO_WARNINGS -DHAVE_FREETYPE=TRUE -Wno-nontrivial-memcall -Wno-nontrivial-memaccess -Wno-unknown-warning-option -W
ft_flag       = $optm_flag $dbg_flag -D_CRT_SECURE_NO_WARNINGS -DFT2_BUILD_LIBRARY -DFT_DISABLE_ZLIB=FALSE -DFT_DISABLE_BZIP2=TRUE -DFT_DISABLE_PNG=TRUE -DFT_DISABLE_BROTLI=TRUE -DFT_CONFIG_OPTION_USE_HARFBUZZ=TRUE -DFT_DISABLE_HARFBUZZ=FALSE -DHARFBUZZ_FOUND=TRUE -DFT_CONFIG_MODULES_H=\<ftmodule.h\>

########################
###    PATH  VARS    ###
########################


srcdir        = source
filesdir      = $srcdir/filesystem
ftmdir        = $srcdir/ftmodule
sotedir       = $srcdir/sote
descdir       = $srcdir/project_description

builddir      = build
flagsdir      = $builddir/flags
depsdir       = $builddir/deps
objdir        = $builddir/obj
gameobj       = $objdir/game
editdir       = $objdir/edit
bindir        = $builddir/bin

blankdir      = $depsdir/BlankProject
projdir       = $blankdir/src

dcondir       = $depsdir/DataContainer
dluadir       = $depsdir/DataContainer-Lua

glmdir        = $depsdir/glm
#ftdir        = $depsdir/freetype
#hbdir        = $depsdir/harfbuzz
ftdir         = $blankdir/build/_deps/freetype-src
hbdir         = $blankdir/build/_deps/harfbuzz-src

glewdir       = $depsdir/glew-cmake
glfwdir       = $depsdir/glfw
imgdir        = $depsdir/imgui
tbbdir        = $depsdir/oneTBB
luajdir       = $depsdir/LuaJIT

glewobj       = $objdir/glew
glfwobj       = $objdir/glfw
imgobj        = $objdir/imgui
luajobj       = $objdir/luajit
tbbobj        = $objdir/onetbb

ftobj         = $objdir/freetype
hbobj         = $objdir/harfbuzz

# ! special lunasvg ! #
lunadir       = $projdir/lunasvg
lunaobj       =   $objdir/lunasvg

########################
###  INCLUDES  VARS  ###
########################

sote_incl     = -I./$sotedir
desc_incl     = -I./$descdir

dense_incl    = -I./build/deps/BlankProject/build/_deps/datacontainer-src/CommonIncludes
dcon_incl     = -I./$dcondir/DataContainerGenerator

ft_incl       = -I./$ftdir/include
hb_incl       = -I./$hbdir/src
luna_incl     = -I./$lunadir -I./$srcdir/stb_image

state_incl    = -I./$projdir/gamestate
window_incl   = -I./$projdir/window
types_incl    = -I./$projdir/common_types
gfx_incl      = -I./$projdir/graphics -I./$projdir/gui 
sound_incl    = -I./$projdir/sound

filesrc_incl  = -I./$projdir/filesystem $types_incl
text_incl     = -I./$projdir/text $ft_incl $hb_incl

glfw_incl     = -I./$glfwdir/include
glew_incl     = -I./$glewdir/include
glm_incl      = -I./$glmdir
imgui_incl    = -I./$imgdir
luaj_incl     = -I./$luajdir/src
tbb_incl      = -I./$tbbdir/include

com_incl      = -I./ $glfw_incl $glew_incl $glm_incl $imgui_incl $luaj_incl $tbb_incl $dense_incl

data_incl     = -I.

libs          = -L./$glfwdir/build/src/ -Wl,-R./$glfwdir/build/src/ -lglfw3 $
                -L./$glewdir/build/lib/ -Wl,-R./$glewdir/build/lib/ -lGLEW $
                -L./$tbbdir/build/gnu_11.4_cxx11_64_relwithdebinfo/ -Wl,-R./$tbbdir/build/gnu_11.4_cxx11_64_relwithdebinfo/ -ltbb $
                ./$luajdir/src/libluajit.a -lGL -licuuc

#######################
###   RULES  LIST   ###
#######################

rule clone_dcon
  command = (git clone -b to_upstream --single-branch https://github.com/ineveraskedforthis/DataContainer.git $dcondir) || (cd $dcondir && git pull origin master && cd ..) && touch $flagsdir/dcon_cloned

rule clone_dcon_lua
  command = (git clone -b allow-creation --single-branch https://github.com/ineveraskedforthis/DataContainer-Lua.git $dluadir) || (cd $dluadir && git pull origin allow-creation && git checkout allow-creation  && cd ..) && touch $flagsdir/dcon_lua_cloned

rule clone_blank_project
  command = git clone https://github.com/ineveraskedforthis/BlankProject.git $blankdir || (cd $blankdir && git pull origin && cd ..) && touch $flagsdir/blank_project_cloned

rule clone_check
  command     = test ! -d $dir && git clone $${branch:+-b '$branch'} --single-branch --depth 1 '$url' '$dir' $
             || git -C $out_dir pull origin ${branch} $
             && mkdir -p $flagsdir && touch $out
  description = [git] checking $dir : $in
  restat      = 1

rule run
  command     = ./$in $run_args $
             && mkdir -p $flagsdir && touch $out
  description = [run] $in
  restat      = 1

# CONFIGURE RULES

rule configure_blank_project
  command = mkdir -p $blankdir/build && cmake -S $blankdir -B $blankdir/build -G Ninja -D CMAKE_CXX_COMPILER=$cpp_cmpl -D CMAKE_CXX_COMPILER=$cpp_cmpl -D CMAKE_C_COMPILER=$c_cmpl && touch $flagsdir/blank_project_configured

rule configure_glfw
  command = mkdir -p $glfwdir/build && cmake -S $glfwdir -B $glfwdir/build -G "Ninja" -D CMAKE_C_COMPILER=$c_cmpl -D CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded && touch $flagsdir/glfw_configured

rule configure_glew
  command = cmake -S $glewdir -B $glewdir/build -G "Ninja" -D CMAKE_C_COMPILER=$c_cmpl -D CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DGLEW_EGL=1 && touch $flagsdir/glew_configured

rule configure_onetbb
  command = mkdir -p $tbbdir/build && cmake -B $tbbdir/build -S $tbbdir -G Ninja -D CMAKE_C_COMPILER=$c_cmpl -D CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DTBB_TEST=OFF && touch $flagsdir/onetbb_configured

# BUILD RULES

rule build_glfw
  command   = cmake --build $glfwdir/build && touch $flagsdir/glfw_built

rule build_glew
  command   = cmake --build $glewdir/build && touch $flagsdir/glew_built

rule build_onetbb
  command   = cmake --build $tbbdir/build && touch $flagsdir/onetbb_built

rule build_luajit
  command   = make -C $luajdir -j$$(nproc) CC="$c_cmpl" CCDEBUG="-g" && touch $flagsdir/luajit_built

# COMPILE RULES

rule ccpp_link
  command     = $cpp_cmpl $cpp_std $cmpl_flag $cmpl_incl $cmpl_src -o $out
  description = [$cpp_cmpl] $cmpl_src -> $out
  restat      = 1

rule link
  command = $cpp_cmpl $cpp_std $link_flag $in -Wl,-E $libs -mavx2 -o $out
  description = link $out

rule ccpp
  command     = $cpp_cmpl $cpp_std $cmpl_flag -MD -MF $out.d $cmpl_incl -c $cmpl_src -o $out
  description = [$cpp_cmpl] $cmpl_src -> $out
  depfile     = $out.d

rule cc
  command     = $c_cmpl $cmpl_flag -MD -MF $out.d $cmpl_incl -c $cmpl_src -o $out
  description = [$c_cmpl] $cmpl_src -> $out
  depfile     = $out.d

rule ccpp_harfbuzz
  command = $cpp_cmpl $cpp_std $hb_flag -MD -MF $out.d $hb_incl $ft_incl -c $in -o $out
  description = compile $out
  depfile = $out.d

rule cc_freetype
  command = $c_cmpl $ft_flag -MD -MF $out.d $ft_incl -I$ftmdir -c $in -o $out
  description = compile $out
  depfile = $out.d

#######################
###   BUILD  LIST   ###
#######################

# LINK ENGINE

build 010 : link $gameobj/main.o $gameobj/locale.o $gameobj/window_platform.o  $gameobj/gl_wrapper.o $gameobj/dcon_common.o $gameobj/sote_functions.o $
              $gameobj/alice_ui.o $gameobj/read_ui_files.o $gameobj/templates_loading.o $gameobj/simple_fs.o $gameobj/parsers.o $gameobj/fonts.o $
              $gameobj/render_alice_ui.o $gameobj/asvg.o $gameobj/texture.o $gameobj/text_render.o $gameobj/text.o $gameobj/frustum.o $
              $ftobj/gzip/ftgzip.o $ftobj/sfnt/sfnt.o $ftobj/psnames/psnames.o $ftobj/ftbitmap.o $ftobj/ftsystem.o $
              $ftobj/ftdebug.o $ftobj/ftbase.o $ftobj/ftbbox.o $ftobj/ftglyph.o $ftobj/ft-hb.o $
              $ftobj/ft-hb-ft.o $ftobj/ftmm.o $ftobj/smooth/smooth.o $ftobj/raster/raster.o $ftobj/sdf/sdf.o $
              $ftobj/src/truetype/truetype.o $ftobj/ftsvg.o $ftobj/ftinit.o $ftobj/cff/cff.o $
              $hbobj/hb-aat-layout.o $hbobj/hb-aat-map.o $hbobj/hb-blob.o $hbobj/hb-buffer-serialize.o $
              $hbobj/hb-buffer-verify.o $hbobj/hb-buffer.o $hbobj/hb-common.o $hbobj/hb-draw.o $hbobj/hb-paint.o $
              $hbobj/hb-paint-extents.o $hbobj/hb-face.o $hbobj/hb-face-builder.o $hbobj/hb-fallback-shape.o $
              $hbobj/hb-font.o $hbobj/hb-map.o $hbobj/hb-number.o $hbobj/hb-ot-cff1-table.o $
              $hbobj/hb-ot-cff2-table.o $hbobj/hb-ot-color.o $hbobj/hb-ot-face.o $hbobj/hb-ot-font.o $hbobj/hb-ft.o $
              $hbobj/hb-outline.o $hbobj/hb-ot-layout.o $hbobj/hb-ot-map.o $hbobj/hb-ot-math.o $hbobj/hb-ot-meta.o $
              $hbobj/hb-ot-metrics.o $hbobj/hb-ot-name.o $hbobj/hb-ot-shaper-arabic.o $hbobj/hb-ot-shaper-default.o $
              $hbobj/hb-ot-shaper-hangul.o $hbobj/hb-ot-shaper-hebrew.o $hbobj/hb-ot-shaper-indic-table.o $
              $hbobj/hb-ot-shaper-indic.o $hbobj/hb-ot-shaper-khmer.o $hbobj/hb-ot-shaper-myanmar.o $hbobj/hb-ucd.o $
              $hbobj/hb-ot-shaper-syllabic.o $hbobj/hb-ot-shaper-thai.o $hbobj/hb-ot-shaper-use.o $hbobj/hb-unicode.o $
              $hbobj/hb-ot-shaper-vowel-constraints.o $hbobj/hb-ot-shape-fallback.o $hbobj/hb-ot-shape-normalize.o $
              $hbobj/hb-ot-shape.o $hbobj/hb-ot-tag.o $hbobj/hb-ot-var.o $hbobj/hb-set.o $hbobj/hb-shape-plan.o $
              $hbobj/hb-shape.o $hbobj/hb-shaper.o $hbobj/hb-static.o $hbobj/hb-style.o $
              $lunaobj/plutovg-surface.o $lunaobj/svgtextelement.o $lunaobj/lunasvg.o $lunaobj/graphics.o $
              $lunaobj/svggeometryelement.o $lunaobj/svgelement.o $lunaobj/svgrenderstate.o $lunaobj/svgproperty.o $
              $lunaobj/svgparser.o $lunaobj/svgpaintelement.o $lunaobj/svglayoutstate.o $lunaobj/plutovg-canvas.o $
              $lunaobj/plutovg-blend.o $lunaobj/plutovg-rasterize.o $lunaobj/plutovg-path.o $lunaobj/plutovg-paint.o $
              $lunaobj/plutovg-matrix.o $lunaobj/plutovg-ft-stroker.o $lunaobj/plutovg-ft-raster.o $lunaobj/plutovg-ft-math.o $
              $lunaobj/plutovg-font.o $
              $imgobj/imgui_stdlib.o $imgobj/imgui_backend_gl.o $imgobj/imgui_backend.o $imgobj/imgui_widgets.o $imgobj/imgui_tables.o $imgobj/imgui_demo.o $
              $imgobj/imgui_draw.o $imgobj/imgui.o $
            | $glfwdir/build/src/glfw3.lib $glewdir/build/lib/libGLEW.so

# BUILD ENGINE

build $gameobj/dcon_common.o : ccpp | $flagsdir/dcon_cloned
  cmpl_src    = $dcondir/CommonIncludes/common_types.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2

build $gameobj/frustum.o : ccpp | $flagsdir/glm_cloned
  cmpl_src    = $srcdir/frustum/frustum.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $glm_incl


build $gameobj/main.o : ccpp | $glfwdir/build/src/glfw3.lib $glewdir/build/lib/libGLEW.so $flagsdir/glm_cloned $flagsdir/imgui_cloned data.hpp data_ids.hpp lua-export.hpp $flagsdir/blank_project_configured $flagsdir/onetbb_cloned $flagsdir/luajit_cloned
  cmpl_src    = $srcdir/main.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $luaj_incl $glfw_incl $glm_incl $imgui_incl $
                $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $window_incl $desc_incl $sote_incl $
                -I./$srcdir/frustum -I./$filesdir

build $gameobj/locale.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/gamestate/locale.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $text_incl $data_incl $tbb_incl $sote_incl

build $gameobj/fonts.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/text/fonts.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $text_incl $filesrc_incl $data_incl $tbb_incl $sote_incl

build $gameobj/text.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/text/text.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $text_incl $filesrc_incl $data_incl $tbb_incl $sote_incl

build $gameobj/sote_functions.o : ccpp | data.hpp lua-export.hpp $flagsdir/blank_project_configured $flagsdir/onetbb_cloned
  cmpl_src    = $sotedir/sote_functions.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $text_incl $data_incl $tbb_incl $sote_incl

build $gameobj/simple_fs.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/filesystem/simple_fs_nix.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $text_incl $filesrc_incl $data_incl $tbb_incl

build $gameobj/templates_loading.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/gamestate/uitemplate_serialization.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $desc_incl

build $gameobj/read_ui_files.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $filesdir/project_file_writing.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $desc_incl

build $gameobj/alice_ui.o : ccpp | $flagsdir/blank_project_configured $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/gui/alice_ui.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $desc_incl

build $gameobj/render_alice_ui.o : ccpp | $flagsdir/blank_project_configured $flagsdir/glm_cloned $flagsdir/imgui_cloned $flagsdir/onetbb_cloned $flagsdir/luajit_cloned data.hpp data_ids.hpp lua-export.hpp $glfwdir/build/src/glfw3.lib $glewdir/build/lib/libGLEW.so
  cmpl_src    = $filesdir/from_alice_editor_main.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $window_incl $desc_incl $glm_incl

build $gameobj/text_render.o : ccpp | $flagsdir/blank_project_configured $flagsdir/glm_cloned $flagsdir/onetbb_cloned data_ids.hpp
  cmpl_src    = $projdir/gui/text_render.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $gfx_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $glm_incl

build $gameobj/texture.o : ccpp | $flagsdir/blank_project_configured
  cmpl_src    = $projdir/graphics/texture.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $luna_incl $filesrc_incl $state_incl

build $gameobj/asvg.o : ccpp | $flagsdir/blank_project_configured
  cmpl_src    = $projdir/graphics/asvg.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $luna_incl $filesrc_incl

build $gameobj/gl_wrapper.o : ccpp | $flagsdir/blank_project_configured $flagsdir/glm_cloned $flagsdir/onetbb_cloned data.hpp data_ids.hpp
  cmpl_src    = $projdir/graphics/opengl_wrapper.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $dense_incl $glm_incl $luna_incl $text_incl $filesrc_incl $data_incl $tbb_incl $state_incl $window_incl

build $gameobj/window_platform.o : ccpp | $flagsdir/blank_project_cloned $flagsdir/glfw_cloned
  cmpl_src    = $projdir/window/window_nix.cpp
  cmpl_flag   = $game_flag
  cmpl_incl   = $glfw_incl $types_incl $state_incl

build $gameobj/parsers.o : ccpp | $flagsdir/blank_project_cloned
  cmpl_src    = $projdir/text/parsers.cpp
  cmpl_flag   = $game_flag


# BUILD PROJECT

build $flagsdir/blank_project_cloned : clone_blank_project
build $flagsdir/blank_project_configured : configure_blank_project | $flagsdir/blank_project_cloned

# BUILD DCON

build $flagsdir/dcon_cloned : clone_dcon
#clone_check
#  url         = https://github.com/ineveraskedforthis/DataContainer.git
#  dir         = $dcondir
#  branch      = to_upstream
build DCON : ccpp_link | $flagsdir/dcon_cloned
  cmpl_src    = $dcondir/DataContainerGenerator/DataContainerGenerator.cpp $dcondir/DataContainerGenerator/parsing.cpp $
                $dcondir/DataContainerGenerator/code_fragments.cpp $dcondir/DataContainerGenerator/query_fragments.cpp $
                $dcondir/DataContainerGenerator/object_member_fragments.cpp $dcondir/DataContainerGenerator/serialize_fragments.cpp
  cmpl_flag   = $optm_flag $dbg_flag -ferror-limit=1
  cmpl_incl   = $dcon_incl $dense_incl
build $flagsdir/dcon_ran | data.hpp data_ids.hpp : run DCON data.txt DCON

# BUILD DCON_LUA

build $flagsdir/dcon_lua_cloned : clone_dcon_lua
#clone_check
#  url         = https://github.com/ineveraskedforthis/DataContainer-Lua.git
#  dir         = $dluadir
#  branch      = allow-creation
build DCON_LUA : ccpp_link | $flagsdir/dcon_lua_cloned $flagsdir/dcon_cloned
  cmpl_src    = $dluadir/src/LuaFFIGenerator.cpp $dluadir/src/parser/parsing.cpp
  cmpl_flag   = $optm_flag $dbg_flag -ferror-limit=1
  cmpl_incl   = $dcon_incl $dense_incl
build $flagsdir/dcon_lua_ran | lua-export.hpp : run DCON_LUA
  run_args    = "sote" "state." "data.txt" "lua-export.cpp" "lua-export.hpp" "./codegen-lua"

# BUILD ONETBB

build $flagsdir/onetbb_cloned : clone_check
  url         = https://github.com/uxlfoundation/oneTBB.git
  dir     = $tbbdir
build $flagsdir/onetbb_configured : configure_onetbb | $flagsdir/onetbb_cloned
build $flagsdir/onetbb_built : build_onetbb | $flagsdir/onetbb_configured

# BUILD LUAJIT

build $flagsdir/luajit_cloned : clone_check
  url         = https://github.com/LuaJIT/LuaJIT.git
  dir         = $luajdir
build $flagsdir/luajit_built : build_luajit | $flagsdir/luajit_cloned

# BUILD GLFW

build $flagsdir/glfw_cloned : clone_check
  url         = https://github.com/glfw/glfw.git
  dir         = $glfwdir
build $flagsdir/glfw_configured : configure_glfw | $flagsdir/glfw_cloned
build $flagsdir/glfw_built | $glfwdir/build/src/glfw3.lib : build_glfw | $flagsdir/glfw_configured

# BUILD GLEW

build $flagsdir/glew_cloned : clone_check
  url         = https://github.com/Perlmint/glew-cmake.git
  dir         = $glewdir
build $flagsdir/glew_configured : configure_glew $flagsdir/glew_cloned
build $flagsdir/glew_built | $glewdir/build/lib/libGLEW.so : build_glew | $flagsdir/glew_configured

# BUILD GLM

build $flagsdir/glm_cloned : clone_check
  url         = https://github.com/g-truc/glm.git
  dir         = $glmdir

# BUILD IMGUI

build $flagsdir/imgui_cloned : clone_check
  url         = https://github.com/ocornut/imgui.git
  dir         = $imgdir

build $imgobj/imgui.o : ccpp || $flagsdir/imgui_cloned
  cmpl_src    = $imgdir/imgui.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $imgui_incl
build $imgobj/imgui_draw.o : ccpp || $flagsdir/imgui_cloned
  cmpl_src    = $imgdir/imgui_draw.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $imgui_incl
build $imgobj/imgui_demo.o : ccpp || $flagsdir/imgui_cloned
  cmpl_src    = $imgdir/imgui_demo.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $imgui_incl
build $imgobj/imgui_tables.o : ccpp || $flagsdir/imgui_cloned
  cmpl_src    = $imgdir/imgui_tables.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $imgui_incl
build $imgobj/imgui_widgets.o : ccpp || $flagsdir/imgui_cloned
  cmpl_src    = $imgdir/imgui_widgets.cpp
  cmpl_flag   = $optm_flag $dbg_flag -mavx2
  cmpl_incl   = $imgui_incl
build $imgobj/imgui_backend.o : ccpp || $flagsdir/imgui_cloned $flagsdir/glfw_cloned
  cmpl_src    = $imgdir/backends/imgui_impl_glfw.cpp
